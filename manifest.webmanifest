{
  "id": "/gym-tracker/",
  "name": "Gym Tracker",
  "short_name": "Gym",
  "description": "Log your lifts and cardio, track your rest between sets, and watch your numbers go up over time. Works offline, no account needed.",
  "lang": "en-GB",
  "dir": "ltr",
  "start_url": ".",
  "scope": ".",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#f4f5f7",
  "theme_color": "#4f46e5",
  "categories": ["health", "fitness", "lifestyle", "sports"],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "screenshots/log.png",
      "sizes": "641x1278",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Log every set as you go, with the weight pre-filled from last time"
    },
    {
      "src": "screenshots/share.png",
      "sizes": "641x1278",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Send a readable summary of your session to your coach"
    }
  ],
  "shortcuts": [
    {
      "name": "Log a workout",
      "short_name": "Log",
      "description": "Jump straight to today's session",
      "url": "./?tab=log",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "View progress",
      "short_name": "Progress",
      "description": "See your charts and personal bests",
      "url": "./?tab=progress",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Workout history",
      "short_name": "History",
      "description": "Browse past sessions",
      "url": "./?tab=history",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
